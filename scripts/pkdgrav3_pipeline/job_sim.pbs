#!/bin/bash -l
# Stage 1: pkdgrav3 simulation -> $PKC_DIR/snap.<step>.s<pct>.<writer>.pkc (+ $SIM_DIR/snapnames.txt for Rockstar).
# Submit with submit_pipeline.sh (or: qsub -v CONF=<run.conf>,PIPE_ENV=<this dir>/pipeline_env.sh -l select=1:ncpus=192:mem=700gb job_sim.pbs).
# Parameter file: $PKD_PAR if the config sets it (written by setup_production.py), else p.par generated from the
# config by make_pkdgrav3_par.py.
# Restart: RESTART=<checkpoint> (or RESTART=latest: newest checkpoints/*.chk) continues from a checkpoint
# (submit_pipeline.sh --restart latest). Without RESTART the simulation starts again from the ICs.
# Outputs: if $SIM_DIR/output_steps.txt exists (planned output steps), snapnames.txt lists exactly those steps
# (a snapshot written when pkdgrav3 stops at iWallRunTime or on a STOP file is not a planned output and is ignored).
# SIM_STAGING=1: snapshots and checkpoints staged on the node's local SSD and drained to NFS during the run.
set -u
source "${PIPE_ENV:?pass -v CONF=...,PIPE_ENV=<repo>/scripts/pkdgrav3_pipeline/pipeline_env.sh}"
mkdir -p "$SIM_DIR" "$PKC_DIR" && cd "$SIM_DIR" || exit 1
export PKD_IO_ROOT
# pkdgrav3's run-time environment: pawna (default) or SIM_ENV from run.conf (pegasus: tools/pegasus/env_pegasus.sh,
# conda MPI; it sets mpirun_pegasus_args for launches on several nodes)
source "${SIM_ENV:-$PKD_IO_ROOT/pkdgrav3/bench/phase0/env_pawna.sh}"
(cd "$PKD_IO_ROOT/pkdgrav3" && git log -1 --format="pkdgrav3 source %h %s")
if [ -n "$PKD_PAR" ]; then
  [ -f "$PKD_PAR" ] || { stamp "PKD_PAR=$PKD_PAR not found"; exit 1; }
  PAR=$PKD_PAR
else
  python3 "$PIPE/make_pkdgrav3_par.py" p.par || exit 1
  PAR=p.par
fi
mkdir -p checkpoints
CHK=
if [ -n "${RESTART:-}" ]; then
  CHK=$RESTART
  [ "$CHK" = latest ] && CHK=$(ls "$SIM_DIR"/checkpoints/*.chk 2>/dev/null | sort | tail -1)
  [ -n "$CHK" ] && [ -f "$CHK" ] || { stamp "RESTART=$RESTART: no checkpoint found (checkpoints/*.chk)"; exit 1; }
  CHK=$(readlink -f "$CHK")
  stamp "restart from $CHK"
fi
J=${PBS_JOBID%%.*}; J=${J:-$$}
# Restart from checkpoint step K: whatever an earlier job wrote after step K belongs to a run that no longer exists
# (killed, node or power failure after its last checkpoint): its snapshots beyond K and incomplete checkpoints beyond K,
# and the stale .part files of its drain, are moved to $SIM_DIR/lost_after_chk<K>.<job>/ (same file system, a rename),
# so that this job rewrites those snapshots instead of mixing with them (19-20 Nov 2026: r3/r5 snapshots of the dead
# run were taken as this run's and Rockstar ran on them). The manager is told (sim_rewind): Rockstar and archive work
# on snapshots beyond K done before now is redone.
CHK_STEP=
if [ -n "$CHK" ]; then
  CHK_STEP=$(basename "$CHK" | sed -n 's/^.*\.\([0-9][0-9]*\)\.chk$/\1/p')
  if [ -n "$CHK_STEP" ]; then
    LOST="$SIM_DIR/lost_after_chk$CHK_STEP.$J"; nlost=0
    for f in "$PKC_DIR"/snap.* "$SIM_DIR"/checkpoints/snap.*; do
      [ -e "$f" ] || continue
      b=${f##*/}; s=${b#snap.}; s=${s%%.*}
      [[ $s =~ ^[0-9]+$ ]] || continue
      if [ $((10#$s)) -gt $((10#$CHK_STEP)) ] || [[ $b =~ \.part[0-9]*$ ]] || [[ $b == *.rescue_tmp* ]]; then
        d="$LOST/$(basename "$(dirname "$f")")"
        mkdir -p "$d" && mv "$f" "$d/" && nlost=$((nlost + 1))
      fi
    done
    if [ $nlost -gt 0 ]; then
      stamp "restart from step $CHK_STEP: $nlost files of an earlier job after that step (or .part) moved to $LOST"
    fi
    event sim_rewind step="$CHK_STEP" moved="$nlost" dir="$LOST"
  fi
fi
NTH=${PBS_NCPUS:-$SIM_NCPU}
# SIM_GPU=1 (pegasus GPU nodes, one P100 each): the CUDA build $PKD_IO_ROOT/build_gpu (build_pkdgrav3_gpu_pegasus.sh);
# submit_pipeline.sh then asks for ngpus=1 per node. SIM_BUILD overrides the build directory.
PKD_BIN=$PKD_IO_ROOT/${SIM_BUILD:-$([ "${SIM_GPU:-0}" = 1 ] && echo build_gpu || echo build)}/pkdgrav3
[ -x "$PKD_BIN" ] || { stamp "pkdgrav3 binary $PKD_BIN missing"; exit 1; }
[ "${SIM_GPU:-0}" = 1 ] && stamp "GPU build $PKD_BIN; GPUs: $(nvidia-smi -L 2>/dev/null | tr '\n' ' ' || echo 'nvidia-smi not found')"
# MPI ranks: SIM_MPIPROCS per node on SIM_NODES nodes (pegasus); NTH threads per rank
NRANK=$(( ${SIM_NODES:-1} * ${SIM_MPIPROCS:-1} ))
[ "$NRANK" -gt 1 ] && NTH=$(( SIM_NCPU / ${SIM_MPIPROCS:-1} ))
# events for the manager: snap_ready step=<step> when all files of an output are in $PKC_DIR (staged: the drain's
# "drained snap.<step>" line; otherwise pkdgrav3's snap.<step>.done marker, looked for every SIM_WATCH_S seconds)
snap_watch() {
  if [ "${SIM_STAGING:-0}" = 1 ]; then
    for _ in $(seq 1 600); do [ -f "$SIM_DIR/drain.$J.log" ] && break; kill -0 $$ 2>/dev/null || return; sleep 1; done
    tail -n +1 -F --pid=$$ "$SIM_DIR/drain.$J.log" 2>/dev/null | while read -r _t w name _rest; do
      [ "$w" = drained ] && [[ $name == snap.* ]] && event snap_ready step="${name#snap.}"
    done &
    # when the node's disk is full the drain points pkdgrav3 straight at $PKC_DIR: those snapshots are never
    # "drained"; their .done marker lands in $PKC_DIR. Announced once all their files are there and complete
    # (pkcreader; a marker can arrive while the files of that snapshot are still on the local disk).
    local seen=" " f s
    while kill -0 $$ 2>/dev/null; do
      for f in "$PKC_DIR"/snap.*.done; do
        [ -e "$f" ] || continue; s=${f##*/snap.}; s=${s%.done}
        case "$seen" in *" $s "*) continue ;; esac
        if "$PY" -c 'import sys; sys.path.insert(0, sys.argv[1]); from pkcreader import PkcSnapshot; PkcSnapshot(sys.argv[2])' \
             "$PP" "$PKC_DIR/snap.$s" 2>/dev/null; then
          seen="$seen$s "; event snap_ready step="$s" direct=1
        fi
      done
      sleep "${SIM_WATCH_S:-60}"
    done
  else
    local seen=" " f s
    while kill -0 $$ 2>/dev/null; do
      for f in "$PKC_DIR"/snap.*.done; do
        [ -e "$f" ] || continue; s=${f##*/snap.}; s=${s%.done}
        case "$seen" in *" $s "*) ;; *) seen="$seen$s "; event snap_ready step="$s" ;; esac
      done
      sleep "${SIM_WATCH_S:-30}"
    done
  fi
}
snap_watch < /dev/null > /dev/null 2>&1 &
SNAPWATCH_PID=$!
# node memory for the manager's watchdog (node_mem every SIM_MEMWATCH_S, default 30 min): 20-22 Nov 2026 the 2048^3
# nodes ran with 2-8 GB available and ~125 GB swapped; one simulation and the drains hung (NFS writes stuck).
# pswpin/pswpout (/proc/vmstat, pages swapped in/out since boot): the manager alerts on swap traffic between two
# samples, not on swap merely in use (a 2048^3 run keeps ~120 GB of idle pages in swap at no cost, 24 Nov 2026)
mem_watch() {
  while kill -0 $$ 2>/dev/null; do
    { awk '/^MemAvailable:/{a=$2} /^SwapTotal:/{st=$2} /^SwapFree:/{sf=$2} END{printf "%d %d ", a/1024, (st-sf)/1024}' /proc/meminfo
      awk '/^pswpin /{i=$2} /^pswpout /{o=$2} END{printf "%d %d\n", i, o}' /proc/vmstat; } |
      { read -r av sw si so; event node_mem avail_mb="$av" swap_used_mb="$sw" pswpin="$si" pswpout="$so"; }
    sleep "${SIM_MEMWATCH_S:-1800}"
  done
}
mem_watch < /dev/null > /dev/null 2>&1 &
MEMWATCH_PID=$!
event sim_info nth="$NTH" staging="${SIM_STAGING:-0}" restart="${CHK:-}" restart_step="${CHK_STEP:-}"
# restart: the planned outputs up to the checkpoint step already complete in $PKC_DIR (written by earlier jobs) are
# announced now, so the manager can run Rockstar on them while this job continues (checked as at the end: all files,
# header/trailer, pkcreader). Outputs after the checkpoint step are written again by this job.
if [ -n "$CHK" ] && [ -f output_steps.txt ]; then
  "$PY" - "$PP" "$PKC_DIR" "${CHK_STEP:-0}" $(awk '!/^#/ {print $1}' output_steps.txt) <<'PYEOF' | while read -r s; do event snap_ready step="$s" checked=1 earlier=1; done
import sys, glob
sys.path.insert(0, sys.argv[1])
from pkcreader import PkcSnapshot
d, K = sys.argv[2], int(sys.argv[3], 10)
for s in sys.argv[4:]:
    if K and int(s, 10) > K:
        continue
    if glob.glob('%s/snap.%s.s*.pkc' % (d, s)):
        try:
            PkcSnapshot('%s/snap.%s' % (d, s)); print(s)
        except Exception:
            pass
PYEOF
  stamp "restart: $(grep -c '"earlier": 1' "$EVFILE" 2>/dev/null) earlier outputs announced"
fi
ln -sf run.$J.log run.log      # now, so that run.log follows the running simulation
if [ "${SIM_STAGING:-0}" = 1 ]; then
  # pkdgrav3's staged I/O (tools/staging/run_staged.pbs): snapshots and checkpoints are written to the node's
  # local SSD and copied to $PKC_DIR and $SIM_DIR/checkpoints by pkd_drain.py while the simulation runs, so
  # pkdgrav3 does not wait for NFS (~25 MB/s). Logs: run.<job>.log, staged.<job>.log, drain.<job>.log.
  STAGE_DIR=${SIM_STAGE_DIR:-/var/tmp/${USER}_stage_$(echo "$STEM" | tr / _)_r$REAL}
  stamp "pkdgrav3 with $NTH threads, staged I/O in $STAGE_DIR on $(hostname), parameter file ${CHK:-$PAR}"
  # a stage left on this node by an earlier job of this run (its drain did not finish: killed, hung on NFS, node
  # failure) is not reused: its snapshots may be of a dead run, and its drain's .part files may hang. Set aside on the
  # node (it may hold the only copy of earlier outputs) and reported to the manager; nothing deleted here.
  if [ -e "$STAGE_DIR" ]; then
    LEFT="$STAGE_DIR.left.$J"
    mv "$STAGE_DIR" "$LEFT"
    stamp "stage $STAGE_DIR left by an earlier job: moved to $(hostname):$LEFT ($(du -sh "$LEFT" 2>/dev/null | cut -f1)); not drained"
    event stage_leftover node="$(hostname)" dir="$LEFT" size="$(du -sb "$LEFT" 2>/dev/null | cut -f1)"
  fi
  df -h /var/tmp | tail -1
  env RUNDIR="$SIM_DIR" PAR="$( [ -z "$CHK" ] && readlink -f "$PAR")" RESTART="$CHK" DEST="$PKC_DIR" \
      STAGE="$STAGE_DIR" CHKSTAGE=1 CHKDEST="$SIM_DIR/checkpoints" KEEPCHK="${SIM_KEEPCHK:-2}" NTH="$NTH" \
      PKD_IO_ROOT="$PKD_IO_ROOT" bash "$PKD_IO_ROOT/pkdgrav3/tools/staging/run_staged.pbs"
  rc=$?
  if grep -q "data left in" staged.$J.log; then
    stamp "drain did not finish: data left on $(hostname):$STAGE_DIR (see staged.$J.log for the recover command)"; rc=3
  fi
else
  if [ -n "$CHK" ]; then
    # `import PKDGRAV; PKDGRAV.restore(...)`: the `from PKDGRAV import restore` form makes pkdgrav3 run the whole
    # simulation again from the ICs after the restart (pkdgrav3 docs/compressed_io_plan.md)
    PAR=restart.$J.par
    # SIM_CHECK_INTERVAL (run.conf): steps between checkpoints from this restart on. A checkpoint keeps the parameters
    # it was written with; restore() keyword arguments override them (MSR::ReadCheckpoint: parameters.update(kwargs))
    KW=; [ -n "${SIM_CHECK_INTERVAL:-}" ] && KW=", iCheckInterval=$SIM_CHECK_INTERVAL"
    printf 'import PKDGRAV\nPKDGRAV.restore("%s"%s)\n' "$CHK" "$KW" > "$PAR"
    [ -n "$KW" ] && stamp "restart with iCheckInterval=$SIM_CHECK_INTERVAL (SIM_CHECK_INTERVAL)"
  fi
  if [ "$NRANK" -gt 1 ]; then
    stamp "pkdgrav3: $NRANK MPI ranks (${SIM_MPIPROCS:-1} per node on $(sort -u "$PBS_NODEFILE" | tr '\n' ' ')) x $NTH threads, parameter file $PAR (snapshots straight to $PKC_DIR)"
    # shellcheck disable=SC2086
    /usr/bin/time -v mpirun --hostfile "$PBS_NODEFILE" --bind-to none ${mpirun_pegasus_args:-} ${PYTHONPATH:+-x PYTHONPATH} -np "$NRANK" \
        --map-by ppr:${SIM_MPIPROCS:-1}:node ${SIM_MPI_EXTRA:-} "$PKD_BIN" -sz "$NTH" "$PAR" > run.$J.log 2> time.$J.log
  else
    stamp "pkdgrav3 with $NTH threads, parameter file $PAR (snapshots straight to $PKC_DIR)"
    /usr/bin/time -v mpirun --bind-to none -np 1 -x PYTHONPATH "$PKD_BIN" -sz "$NTH" "$PAR" > run.$J.log 2> time.$J.log
  fi
  rc=$?
fi
ln -sf run.$J.log run.log
grep -E "Elapsed|Maximum resident" time.$J.log
# GPU builds: share of the gravity tiles done on the GPUs over the job (pkdgrav3's per-step "Total tiles processed")
if [ "${SIM_GPU:-0}" = 1 ]; then
  grep -h "Total tiles processed" run.$J.log | awk '{t+=$4; g+=$8} END {if (t) printf "GPU: %.4g of %.4g gravity tiles on the GPUs (%.1f %%)\n", g, t, 100*g/t; else print "GPU: no tile statistics in the log"}' | sed 's/,//g'
fi
# time pkdgrav3 spent writing (it waits for each write): snapshots and checkpoints
for w in Output Checkpoint; do
  grep -h "$w.*successfully written" run.$J.log | awk -v w=$w '{t+=$(NF-1); n++; if($(NF-1)>m)m=$(NF-1)} END {if(n) printf "%s writes: %d, %.0f s in total, longest %.0f s\n", w, n, t, m}'
done
# Rockstar's snapshot number <snap> = line <snap> of snapnames.txt (zero-padded pkdgrav3 steps of the outputs).
# A snapshot counts when all its files are complete (header/trailer/particle count, pkcreader.PkcSnapshot):
# the staging drain does not copy pkdgrav3's .done markers.
if [ -f output_steps.txt ]; then
  NOUT=$(grep -vc '^#' output_steps.txt)
  STEPS=$(awk '!/^#/ {print $1}' output_steps.txt)
else
  NOUT=$(echo $OUT_Z | wc -w)
  STEPS=$(ls "$PKC_DIR" 2>/dev/null | sed -n 's/^snap\.\([0-9]*\)\.s.*\.pkc$/\1/p' | sort -u)
fi
"$PY" - "$PP" "$PKC_DIR" $STEPS > snapnames.txt <<'PYEOF'
import sys, glob
sys.path.insert(0, sys.argv[1])
from pkcreader import PkcSnapshot
d = sys.argv[2]
for s in sys.argv[3:]:
    if glob.glob('%s/snap.%s.s*.pkc' % (d, s)):
        try:
            PkcSnapshot('%s/snap.%s' % (d, s)); print(s)
        except Exception as e:
            print('snapshot %s incomplete: %s' % (s, e), file=sys.stderr)
PYEOF
extra=$(ls "$PKC_DIR" 2>/dev/null | sed -n 's/^snap\.\([0-9]*\)\.s.*\.pkc$/\1/p' | sort -u | grep -vxF -f snapnames.txt | tr '\n' ' ')
[ -n "$extra" ] && stamp "snapshots that are not planned outputs (wall-time/STOP exits), not used: $extra"
NDONE=$(grep -c . snapnames.txt)
stamp "pkdgrav3 exit $rc; $NDONE of $NOUT outputs: $(tr '\n' ' ' < snapnames.txt | cut -c1-300)"
sleep 2; kill $SNAPWATCH_PID $MEMWATCH_PID 2>/dev/null; pkill -P $SNAPWATCH_PID 2>/dev/null
# the complete outputs, checked (pkcreader): the manager's list of snapshots that Rockstar may use
for s in $(cat snapnames.txt); do event snap_ready step="$s" checked=1; done
event sim_outputs ndone="$NDONE" nout="$NOUT" rc="$rc"
# full check (all IDs once, subsamples) of the last output only: reading every snapshot from NFS would take hours
LASTS=$(tail -1 snapnames.txt)
[ -n "$LASTS" ] && "$PKD_IO_ROOT/build_snapcomp/pkc_check" --threads "$NTH" "$PKC_DIR/snap.$LASTS" | tail -2
du -sh "$PKC_DIR"
if [ $rc -eq 0 ] && [ "$NDONE" -lt "$NOUT" ]; then
  stamp "pkdgrav3 stopped before the last output (iWallRunTime or STOP): continue with submit.sh restart"
  ls checkpoints/*.chk 2>/dev/null | tail -2
fi
[ $rc -eq 0 ] && [ "$NDONE" -eq "$NOUT" ] || exit 1
