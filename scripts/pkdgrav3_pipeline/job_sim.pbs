#!/bin/bash -l
# Stage 1: pkdgrav3 simulation -> $PKC_DIR/snap.<step>.s<pct>.<writer>.pkc (+ $SIM_DIR/snapnames.txt for Rockstar).
# Submit with submit_pipeline.sh (or: qsub -v CONF=<run.conf>,PIPE_ENV=<this dir>/pipeline_env.sh -l select=1:ncpus=192:mem=700gb job_sim.pbs).
# Parameter file: $PKD_PAR if the config sets it (written by setup_production.py), else p.par generated from the
# config by make_pkdgrav3_par.py.
# Restart: RESTART=<checkpoint> (or RESTART=latest: newest checkpoints/*.chk) continues from a checkpoint
# (submit_pipeline.sh --restart latest). Without RESTART the simulation starts again from the ICs.
# Outputs: if $SIM_DIR/output_steps.txt exists (planned output steps), snapnames.txt lists exactly those steps
# (a snapshot written when pkdgrav3 stops at iWallRunTime or on a STOP file is not a planned output and is ignored).
# SIM_STAGING=1: snapshots and checkpoints staged on the node's local SSD and drained to NFS during the run.
set -u
source "${PIPE_ENV:?pass -v CONF=...,PIPE_ENV=<repo>/scripts/pkdgrav3_pipeline/pipeline_env.sh}"
mkdir -p "$SIM_DIR" "$PKC_DIR" && cd "$SIM_DIR" || exit 1
export PKD_IO_ROOT
source "$PKD_IO_ROOT/pkdgrav3/bench/phase0/env_pawna.sh"
(cd "$PKD_IO_ROOT/pkdgrav3" && git log -1 --format="pkdgrav3 source %h %s")
if [ -n "$PKD_PAR" ]; then
  [ -f "$PKD_PAR" ] || { stamp "PKD_PAR=$PKD_PAR not found"; exit 1; }
  PAR=$PKD_PAR
else
  python3 "$PIPE/make_pkdgrav3_par.py" p.par || exit 1
  PAR=p.par
fi
mkdir -p checkpoints
CHK=
if [ -n "${RESTART:-}" ]; then
  CHK=$RESTART
  [ "$CHK" = latest ] && CHK=$(ls "$SIM_DIR"/checkpoints/*.chk 2>/dev/null | sort | tail -1)
  [ -n "$CHK" ] && [ -f "$CHK" ] || { stamp "RESTART=$RESTART: no checkpoint found (checkpoints/*.chk)"; exit 1; }
  CHK=$(readlink -f "$CHK")
  stamp "restart from $CHK"
fi
NTH=${PBS_NCPUS:-$SIM_NCPU}
J=${PBS_JOBID%%.*}; J=${J:-$$}
# events for the manager: snap_ready step=<step> when all files of an output are in $PKC_DIR (staged: the drain's
# "drained snap.<step>" line; otherwise pkdgrav3's snap.<step>.done marker, looked for every SIM_WATCH_S seconds)
snap_watch() {
  if [ "${SIM_STAGING:-0}" = 1 ]; then
    for _ in $(seq 1 600); do [ -f "$SIM_DIR/drain.$J.log" ] && break; kill -0 $$ 2>/dev/null || return; sleep 1; done
    tail -n +1 -F --pid=$$ "$SIM_DIR/drain.$J.log" 2>/dev/null | while read -r _t w name _rest; do
      [ "$w" = drained ] && [[ $name == snap.* ]] && event snap_ready step="${name#snap.}"
    done
  else
    local seen=" " f s
    while kill -0 $$ 2>/dev/null; do
      for f in "$PKC_DIR"/snap.*.done; do
        [ -e "$f" ] || continue; s=${f##*/snap.}; s=${s%.done}
        case "$seen" in *" $s "*) ;; *) seen="$seen$s "; event snap_ready step="$s" ;; esac
      done
      sleep "${SIM_WATCH_S:-30}"
    done
  fi
}
snap_watch < /dev/null > /dev/null 2>&1 &
SNAPWATCH_PID=$!
event sim_info nth="$NTH" staging="${SIM_STAGING:-0}" restart="${CHK:-}"
ln -sf run.$J.log run.log      # now, so that run.log follows the running simulation
if [ "${SIM_STAGING:-0}" = 1 ]; then
  # pkdgrav3's staged I/O (tools/staging/run_staged.pbs): snapshots and checkpoints are written to the node's
  # local SSD and copied to $PKC_DIR and $SIM_DIR/checkpoints by pkd_drain.py while the simulation runs, so
  # pkdgrav3 does not wait for NFS (~25 MB/s). Logs: run.<job>.log, staged.<job>.log, drain.<job>.log.
  STAGE_DIR=${SIM_STAGE_DIR:-/var/tmp/${USER}_stage_$(echo "$STEM" | tr / _)_r$REAL}
  stamp "pkdgrav3 with $NTH threads, staged I/O in $STAGE_DIR on $(hostname), parameter file ${CHK:-$PAR}"
  df -h /var/tmp | tail -1
  env RUNDIR="$SIM_DIR" PAR="$( [ -z "$CHK" ] && readlink -f "$PAR")" RESTART="$CHK" DEST="$PKC_DIR" \
      STAGE="$STAGE_DIR" CHKSTAGE=1 CHKDEST="$SIM_DIR/checkpoints" KEEPCHK="${SIM_KEEPCHK:-2}" NTH="$NTH" \
      PKD_IO_ROOT="$PKD_IO_ROOT" bash "$PKD_IO_ROOT/pkdgrav3/tools/staging/run_staged.pbs"
  rc=$?
  if grep -q "data left in" staged.$J.log; then
    stamp "drain did not finish: data left on $(hostname):$STAGE_DIR (see staged.$J.log for the recover command)"; rc=3
  fi
else
  if [ -n "$CHK" ]; then
    # `import PKDGRAV; PKDGRAV.restore(...)`: the `from PKDGRAV import restore` form makes pkdgrav3 run the whole
    # simulation again from the ICs after the restart (pkdgrav3 docs/compressed_io_plan.md)
    PAR=restart.$J.par
    printf 'import PKDGRAV\nPKDGRAV.restore("%s")\n' "$CHK" > "$PAR"
  fi
  stamp "pkdgrav3 with $NTH threads, parameter file $PAR (snapshots straight to $PKC_DIR)"
  /usr/bin/time -v mpirun --bind-to none -np 1 -x PYTHONPATH "$PKD_IO_ROOT/build/pkdgrav3" -sz "$NTH" "$PAR" > run.$J.log 2> time.$J.log
  rc=$?
fi
ln -sf run.$J.log run.log
grep -E "Elapsed|Maximum resident" time.$J.log
# time pkdgrav3 spent writing (it waits for each write): snapshots and checkpoints
for w in Output Checkpoint; do
  grep -h "$w.*successfully written" run.$J.log | awk -v w=$w '{t+=$(NF-1); n++; if($(NF-1)>m)m=$(NF-1)} END {if(n) printf "%s writes: %d, %.0f s in total, longest %.0f s\n", w, n, t, m}'
done
# Rockstar's snapshot number <snap> = line <snap> of snapnames.txt (zero-padded pkdgrav3 steps of the outputs).
# A snapshot counts when all its files are complete (header/trailer/particle count, pkcreader.PkcSnapshot):
# the staging drain does not copy pkdgrav3's .done markers.
if [ -f output_steps.txt ]; then
  NOUT=$(grep -vc '^#' output_steps.txt)
  STEPS=$(awk '!/^#/ {print $1}' output_steps.txt)
else
  NOUT=$(echo $OUT_Z | wc -w)
  STEPS=$(ls "$PKC_DIR" 2>/dev/null | sed -n 's/^snap\.\([0-9]*\)\.s.*\.pkc$/\1/p' | sort -u)
fi
"$PY" - "$PP" "$PKC_DIR" $STEPS > snapnames.txt <<'PYEOF'
import sys, glob
sys.path.insert(0, sys.argv[1])
from pkcreader import PkcSnapshot
d = sys.argv[2]
for s in sys.argv[3:]:
    if glob.glob('%s/snap.%s.s*.pkc' % (d, s)):
        try:
            PkcSnapshot('%s/snap.%s' % (d, s)); print(s)
        except Exception as e:
            print('snapshot %s incomplete: %s' % (s, e), file=sys.stderr)
PYEOF
extra=$(ls "$PKC_DIR" 2>/dev/null | sed -n 's/^snap\.\([0-9]*\)\.s.*\.pkc$/\1/p' | sort -u | grep -vxF -f snapnames.txt | tr '\n' ' ')
[ -n "$extra" ] && stamp "snapshots that are not planned outputs (wall-time/STOP exits), not used: $extra"
NDONE=$(grep -c . snapnames.txt)
stamp "pkdgrav3 exit $rc; $NDONE of $NOUT outputs: $(tr '\n' ' ' < snapnames.txt | cut -c1-300)"
sleep 2; kill $SNAPWATCH_PID 2>/dev/null
# the complete outputs, checked (pkcreader): the manager's list of snapshots that Rockstar may use
for s in $(cat snapnames.txt); do event snap_ready step="$s" checked=1; done
event sim_outputs ndone="$NDONE" nout="$NOUT" rc="$rc"
# full check (all IDs once, subsamples) of the last output only: reading every snapshot from NFS would take hours
LASTS=$(tail -1 snapnames.txt)
[ -n "$LASTS" ] && "$PKD_IO_ROOT/build_snapcomp/pkc_check" --threads "$NTH" "$PKC_DIR/snap.$LASTS" | tail -2
du -sh "$PKC_DIR"
if [ $rc -eq 0 ] && [ "$NDONE" -lt "$NOUT" ]; then
  stamp "pkdgrav3 stopped before the last output (iWallRunTime or STOP): continue with submit.sh restart"
  ls checkpoints/*.chk 2>/dev/null | tail -2
fi
[ $rc -eq 0 ] && [ "$NDONE" -eq "$NOUT" ] || exit 1
