#!/bin/bash -l
# Optional stage after the halo catalogues: stacked potential profiles around halos (volume weighted by default),
# scripts/gadget_pkdgrav3_compare/halo_potential_profile.py on the .pkc snapshots that store the potential and the
# consistent-trees catalogues out_<snap>.trees. Mean, scatter and jackknife error of phi in shells of comoving r
# around host halos, per mass bin (the same bins as stage xcorr). Volume weighting: the code's potential is put on a
# grid (local linear fit to the k nearest particles) and the grid points are stacked, so every shell is an average
# over space, not over mass.
#   submit_pipeline.sh <run.conf> --stages vprof         (postprocess.sh vprof; manager page: post-processing)
# Config (all optional):
#   VPROF_SNAPS    snapshots, comma separated; default (or "all"): every output whose .pkc store the potential
#                  (z <= 0.5 in production); "last": the last one only
#   VPROF_WEIGHT   volume | particle | "volume particle" (default volume)
#   VPROF_MBINS    halo mass bin edges, Msun/h, Mvir (default: --mbins of XC_ARGS, else the xcorr default
#                  2e12,1e13,5e13,2e14,1e16)
#   VPROF_RBINS    radial bins (default 0.02,50,36: 36 log bins 0.02-50 Mpc/h; lin:0,50,0.2 for linear)
#   VPROF_SUB      .pkc subsamples read (default: all particles); e.g. 1,3,5 (9 %) for 2048^3, where all particles
#                  in one KD-tree for the gridding do not fit in memory
#   VPROF_ARGS     other options of halo_potential_profile.py (default: --max-halos 20000 per bin, --target 8192
#                  for volume weighting, grid 2 x the particle grid per side)
#   VPROF_NCPU, VPROF_MEM, VPROF_WALL   resources (default 32 cores, 160gb, 48 h; used by submit_pipeline.sh)
#                  Measured (pawna, 32 cores, /usr/bin/time -v): 512^3, grid 1024^3: 7.9 min per snapshot, 15 GB max
#                  RSS of one process; 37 snapshots ~5 h. The grid fit scales with grid points (~8x for 1024^3 particles).
# Output: $HALO_DIR/vprof/out_<snap>_vprof_<weight>.npz (kept with the run). Restart: rerun; existing outputs are
# skipped. The gridded potential (4 bytes per grid point) is a temporary file in $HALO_DIR/vprof/tmp, removed after
# each snapshot.
set -u
source "${PIPE_ENV:?pass -v CONF=...,PIPE_ENV=<repo>/scripts/pkdgrav3_pipeline/pipeline_env.sh}"
PROF=$SANDBOX/scripts/gadget_pkdgrav3_compare/halo_potential_profile.py
NS=$(grep -c . "$SIM_DIR/snapnames.txt")
# outputs with the potential: those whose s01 file stores it (pkcreader); cheap, header only
POTSNAPS=$(PYTHONPATH=$PP "$PY" - "$SIM_DIR/snapnames.txt" "$PKC_DIR" <<'EOF'
import os, sys
import pkcreader
steps = [l.split()[0] for l in open(sys.argv[1]) if l.strip()]
out = []
for i, st in enumerate(steps):
    p = os.path.join(sys.argv[2], 'snap.%05d' % int(st))
    try:
        if pkcreader.PkcSnapshot(p).has_potential:
            out.append(str(i))
    except Exception:  # noqa: BLE001  (snapshot deleted or not written)
        pass
print(','.join(out))
EOF
)
case "${VPROF_SNAPS:-all}" in
  all)  SNAPS=$POTSNAPS ;;
  last) SNAPS=$((NS - 1)) ;;
  *)    SNAPS=$VPROF_SNAPS ;;
esac
[ -n "$SNAPS" ] || { stamp "no snapshot with the potential in $PKC_DIR"; exit 1; }
MB=${VPROF_MBINS:-$(echo "${XC_ARGS:-}" | sed -n 's/.*--mbins[ =]\([0-9eE.,+-]*\).*/\1/p')}
MB=${MB:-2e12,1e13,5e13,2e14,1e16}
RB=${VPROF_RBINS:-0.02,50,36}
OUT=$HALO_DIR/vprof; TMP=$OUT/tmp
mkdir -p "$OUT" "$TMP"
W=${NCPUS:-${VPROF_NCPU:-32}}
stamp "snapshots: $SNAPS; mass bins $MB; r bins $RB; weights ${VPROF_WEIGHT:-volume}; $W workers"
rc=0
for s in ${SNAPS//,/ }; do
  step=$(sed -n "$((s + 1))p" "$SIM_DIR/snapnames.txt" | awk '{print $1}')
  snap=$PKC_DIR/snap.$(printf %05d "$((10#$step))")
  for w in ${VPROF_WEIGHT:-volume}; do
    out=$OUT/out_${s}_vprof_$w.npz
    [ -f "$out" ] && { stamp "skip $out (exists)"; continue; }
    extra=(--weight "$w")
    [ "$w" = volume ] && extra+=(--target 8192 --vcache "$TMP/out_${s}.vgrid.npy")
    [ -n "${VPROF_SUB:-}" ] && extra+=(--pkc-subsamples "$VPROF_SUB")
    stamp "snapshot $s (step $step, $w) -> $out"
    PYTHONPATH=$PP /usr/bin/time -v "$PY" -W ignore "$PROF" pkc "$snap" "$HALO_DIR/out_$s.trees" "$out.tmp.npz" \
        --mbins "$MB" --mass-col mvir --rbins "$RB" --par "$SIM_DIR/p.par" --workers "$W" "${extra[@]}" ${VPROF_ARGS:-} \
        2> "$LOGS/vprof_time.${PBS_JOBID%%.*}.$s.$w.log"
    r=$?
    grep -E "Elapsed|Maximum resident" "$LOGS/vprof_time.${PBS_JOBID%%.*}.$s.$w.log"
    if [ $r = 0 ]; then mv "$out.tmp.npz" "$out"; else rc=1; rm -f "$out.tmp.npz"; stamp "snapshot $s ($w) failed (rc $r)"; fi
  done
  rm -f "$TMP/out_${s}.vgrid.npy"
done
rmdir "$TMP" 2>/dev/null
stamp "vprof stage exit $rc; $(ls "$OUT"/*.npz 2>/dev/null | wc -l) profiles"
event vprof_done rc="$rc" nprof="$(ls "$OUT"/*.npz 2>/dev/null | wc -l)"
exit $rc
