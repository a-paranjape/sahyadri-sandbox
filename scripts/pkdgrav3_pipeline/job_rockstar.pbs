#!/bin/bash -l
# Stage 2: Rockstar on all outputs, reading the .pkc snapshots directly (FILE_FORMAT = "PKC"), or Gadget-4 HDF5
# snapshots snapshot_<snap>.hdf5 in $SIM_DIR when the config sets SIM_CODE=gadget4 (FILE_FORMAT = "AREPO").
# Server and client run in this one job on one node. Output: $HALO_DIR/out_<snap>.list, rockstar.cfg (the full
# configuration Rockstar used), restart.cfg and the newest snapshot's halos_<snap>.*.bin (for restarts).
# RS_LOCAL_OUT=1 (default): Rockstar writes to the node's local disk (RS_LOCAL_DIR, default /var/tmp), and the
#   finished out_<snap>.list, restart.cfg and the newest halos_<snap>.*.bin are copied to $HALO_DIR every
#   RS_SYNC_S seconds and at the end. Rockstar writes its halo files inside the halo-finding phase, so on /storage
#   (NFS) that phase waits for the disk: 188 s -> 114 s for two 512^3 snapshots (pawna job 2536781).
#   RS_LOCAL_OUT=0: write to $HALO_DIR directly (as before; all halos_<snap>.* kept).
# Writers: one per core of the job (PBS_NCPUS, NCPUS, else RS_NCPU) unless RS_WRITERS_FIXED=1 (then the configuration's NUM_WRITERS):
#   16 -> 32 -> 64 writers took 114 -> 78 -> 64 s in the same test, peak memory 7.5 -> 7.4 -> 8.1 GB.
# Restart: rerun the job; it starts from scratch unless RS_RESTART=1 (then Rockstar's restart.cfg is used).
# Batches (RS_SNAP_FIRST=<a> RS_SNAP_LAST=<b>, set by tools/sahyadri_manager while the simulation runs): snapshots
#   a..b only, with the snapshot list cut after b (the planned outputs of output_steps.txt, so the simulation need not
#   have finished) and RESTART_SNAP = a: Rockstar reads the halos_<a-1>.*.bin of the previous batch (kept in
#   $HALO_DIR) for the merger links. Same catalogues as one run over all snapshots (pawna test, t128/batch vs single).
set -u
source "${PIPE_ENV:?pass -v CONF=...,PIPE_ENV=<repo>/scripts/pkdgrav3_pipeline/pipeline_env.sh}"
RS=$CODES/rockstar/rockstar
# Rockstar names its halo files after the snapshot NAME (line <snap> of SNAPSHOT_NAMES, the pkdgrav3 step, e.g.
# halos_02126.*.bin) but its catalogues after the snapshot NUMBER (out_100.list): convert with these two
sname() { sed -n "$(( $1 + 1 ))p" "$NAMEF"; }                                   # number -> name
snum() { awk -v n="$1" '$1 == n {print NR - 1; exit}' "$NAMEF"; }               # name -> number
binsnaps() { ls "$1" | sed -n 's/^halos_\([^.]*\)\..*\.bin$/\1/p' | sort -u | while read -r n_; do echo "$(snum "$n_") $n_"; done | sort -n; }
FIRST=${RS_SNAP_FIRST:-}; LAST=${RS_SNAP_LAST:-}
mkdir -p "$HALO_DIR" && cd "$HALO_DIR" || exit 1
if [ -n "$FIRST" ]; then   # batch: snapshot list = the first LAST+1 planned outputs
  [ -n "$LAST" ] && [ "$LAST" -ge "$FIRST" ] || { stamp "RS_SNAP_FIRST=$FIRST needs RS_SNAP_LAST >= it"; exit 1; }
  if [ -f "$SIM_DIR/output_steps.txt" ]; then awk '!/^#/ {print $1}' "$SIM_DIR/output_steps.txt" > snapnames_planned.txt
  else cp "$SIM_DIR/snapnames.txt" snapnames_planned.txt || exit 1; fi
  NS=$(grep -c . snapnames_planned.txt)
  [ "$LAST" -lt "$NS" ] || { stamp "RS_SNAP_LAST=$LAST but only $NS planned outputs"; exit 1; }
  NAMES=$HALO_DIR/snapnames_b$((LAST + 1)).txt; head -n $((LAST + 1)) snapnames_planned.txt > "$NAMES"; NAMEF=$NAMES
  # every snapshot of the batch complete (header, trailer, particle count of each file: pkcreader.PkcSnapshot)
  "$PY" - "$PP" "$PKC_DIR" $(sed -n "$((FIRST + 1)),$((LAST + 1))p" "$NAMES") <<'PYEOF' || { stamp "batch $FIRST-$LAST: snapshots not complete"; exit 1; }
import sys
sys.path.insert(0, sys.argv[1])
from pkcreader import PkcSnapshot
bad = 0
for s in sys.argv[3:]:
    try:
        PkcSnapshot('%s/snap.%s' % (sys.argv[2], s))
    except Exception as e:
        print('snapshot %s not complete: %s' % (s, e)); bad += 1
sys.exit(1 if bad else 0)
PYEOF
  FIRST0=$FIRST
  # A rerun of a batch that stopped part way continues after its newest finished snapshot m (whose halos_<m>.*.bin
  # sync_out kept in $HALO_DIR). Rockstar writes out_<m>.list only after snapshot m+1 (the descendants), and a
  # restart at m+1 from halos_<m> writes it again (out_58.list of r4 was rewritten by the batch starting at 59), so
  # out_<FIRST>..out_<m-1>.list are needed, not out_<m>.list. The halos_<m> set must be whole: NUM_WRITERS files
  # (rockstar.cfg of the earlier attempt), none empty. (pawna r3 batch 85 and r4 batch 59, 25 Nov: the old check
  # asked for out_<m>.list, so the reruns stopped with "no halos_<FIRST-1>" although they could continue.)
  m=; mfirst=$FIRST
  if [ "$FIRST" -gt 0 ]; then
    # m: the newest set below restart.cfg's RESTART_SNAP (Rockstar had finished it; with RS_LOCAL_OUT=0 a newer set
    # in $HALO_DIR may be half written)
    r_=$(awk -F= '$1 ~ /^ *RESTART_SNAP *$/ {print $2+0}' restart.cfg 2>/dev/null)
    m=$(binsnaps "$HALO_DIR" | awk -v r="${r_:-0}" '$1 != "" && $1 < r {n=$1} END {print n}')
    okm=0; [ -n "$m" ] && [ "$m" -ge "$FIRST" ] && [ "$m" -le "$LAST" ] && okm=1
    [ $okm = 1 ] && for s_ in $(seq "$FIRST" $((m - 1))); do [ -s out_$s_.list ] || okm=0; done
    if [ $okm = 1 ]; then
      mn=$(sname "$m"); nw_=$(awk -F= '$1 ~ /^ *NUM_WRITERS *$/ {print $2+0}' rockstar.cfg 2>/dev/null)
      nf_=$(ls | grep -c "^halos_$mn\.[0-9]*\.bin$"); ne_=$(find . -maxdepth 1 -name "halos_$mn.*.bin" -size 0 | wc -l)
      [ -n "$nw_" ] && [ "$nf_" = "$nw_" ] && [ "$ne_" = 0 ] || {
        stamp "batch $FIRST-$LAST: halos_$mn.*.bin (snapshot $m) incomplete: $nf_ files of ${nw_:-?} writers, $ne_ empty"; okm=0; }
    fi
    if [ $okm = 1 ] && [ "$m" -eq "$LAST" ] && [ ! -s out_$LAST.list ]; then
      okm=0   # the last snapshot finished but its catalogue was not written: redo it from halos_<LAST-1> if kept
    fi
    [ $okm = 1 ] && mfirst=$((m + 1))
  fi
  if [ "$mfirst" -gt "$FIRST" ]; then
    stamp "batch $FIRST-$LAST: snapshots $FIRST-$m done by an earlier attempt (halos_$(sname "$m"), out_<snap>.list to $((m - 1))), continuing at $mfirst"
    FIRST=$mfirst
  elif [ "$FIRST" -gt 0 ] && ! ls "$HALO_DIR"/halos_"$(sname $((FIRST - 1)))".*.bin > /dev/null 2>&1; then
    stamp "batch $FIRST-$LAST: no halos_$(sname $((FIRST - 1))).*.bin (snapshot $((FIRST - 1))) from the previous batch in $HALO_DIR, and no finished snapshot of this batch to continue from"
    exit 1
  fi
  stamp "batch: snapshots $FIRST-$LAST of $NS (steps $(sed -n "$((FIRST + 1))p" "$NAMES")-$(sed -n "$((LAST + 1))p" "$NAMES"))"
  RS_RESTART=0
  if [ "$FIRST" -gt "$LAST" ]; then
    stamp "batch $FIRST0-$LAST: all snapshots already done"
    event rockstar_done first="$FIRST0" last="$LAST" nsnap="$NS" nlists="$((LAST - FIRST0 + 1))" nsuccess=0 halos_last="$(grep -vc '^#' out_$LAST.list)" ok=1 seconds=0
    exit 0
  fi
else
  [ -s "$SIM_DIR/snapnames.txt" ] || { stamp "no $SIM_DIR/snapnames.txt (run stage sim first)"; exit 1; }
  NS=$(grep -c . "$SIM_DIR/snapnames.txt"); FIRST=0; LAST=$((NS - 1)); NAMES=; FIRST0=0; NAMEF=$SIM_DIR/snapnames.txt
fi
NW=${PBS_NCPUS:-${NCPUS:-$RS_NCPU}}; [ "${RS_WRITERS_FIXED:-0}" = 1 ] && NW=$RS_WRITERS
# Several nodes (RS_NODES > 1, submit_pipeline.sh asks for select=RS_NODES:ncpus=RS_NCPU): Rockstar's server runs here
# and listens on this node's name; one client per node (ssh to the other nodes of the job) forks PER_NODE writers, so
# the particles (and the memory) are spread over the nodes. The halo files go straight to $HALO_DIR (shared): every
# node writes its own writers' files. No MPI: Rockstar talks over TCP sockets, the single-node build is used as is.
NODES=("$(hostname -s)")
[ -n "${PBS_NODEFILE:-}" ] && [ -f "$PBS_NODEFILE" ] && mapfile -t NODES < <(sed 's/\..*//' "$PBS_NODEFILE" | awk '!s[$0]++')
NNODE=${#NODES[@]}
PER_NODE=$NW
if [ "$NNODE" -gt 1 ]; then
  PER_NODE=${RS_WRITERS_PER_NODE:-$NW}; NW=$((PER_NODE * NNODE))
  [ "${RS_LOCAL_OUT:-1}" = 1 ] && { stamp "RS_LOCAL_OUT=1 with $NNODE nodes: the nodes need a shared OUTBASE (set RS_LOCAL_OUT=0)"; exit 1; }
  stamp "Rockstar on $NNODE nodes (${NODES[*]}): $PER_NODE writers each, $NW in all"
fi
OUT=$HALO_DIR
if [ "${RS_LOCAL_OUT:-1}" = 1 ]; then
  OUT=${RS_LOCAL_DIR:-/var/tmp}/${USER}_rockstar_${PBS_JOBID%%.*}
  mkdir -p "$OUT" || { stamp "cannot create $OUT"; exit 1; }
  stamp "Rockstar output on local disk $OUT ($(df -h "$OUT" | awk 'NR==2{print $4}') free), copied to $HALO_DIR"
fi
CFG=$HALO_DIR/rs_input.cfg
if [ "${RS_RESTART:-0}" = 1 ] && [ -f restart.cfg ]; then
  CFG=$HALO_DIR/restart.cfg; stamp "restarting from $CFG"; RESTARTED=1
  [ "$OUT" != "$HALO_DIR" ] && cp -p halos_*.bin "$OUT"/ 2>/dev/null   # previous snapshot's halos for the merger links
elif [ -n "$RS_CFG" ]; then   # configuration written in advance (setup_production.py)
  [ -f "$RS_CFG" ] || { stamp "RS_CFG=$RS_CFG not found"; exit 1; }
  rm -f auto-rockstar.cfg; CFG=$RS_CFG
  nc=$(awk -F= '$1 ~ /^ *NUM_SNAPS *$/ {print $2+0}' "$CFG")
  [ -z "$nc" ] || [ "$nc" = "$NS" ] || { stamp "NUM_SNAPS = $nc in $CFG but $NS outputs"; exit 1; }
else
  rm -f auto-rockstar.cfg
  if [ "${SIM_CODE:-pkdgrav3}" = gadget4 ]; then
    # Gadget-4 HDF5 snapshots, settings of config/halos/rockstar_template.cfg (Sahyadri production)
    FMT='FILE_FORMAT = "AREPO"
AREPO_LENGTH_CONVERSION = 1
AREPO_MASS_CONVERSION = 1e+10'
    FN="snapshot_<snap>.hdf5"; [ "$RS_NUM_BLOCKS" -gt 1 ] && FN="snapshot_<snap>.<block>.hdf5"; INB=$SIM_DIR
  else
    FMT='FILE_FORMAT = "PKC"'; FN="snap.<snap>.<block>"; INB=$PKC_DIR
  fi
  cat > "$CFG" <<EOF
# written by job_rockstar.pbs from $CONF
$FMT
INBASE = "$INB"
FILENAME = "$FN"
SNAPSHOT_NAMES = "$SIM_DIR/snapnames.txt"
NUM_SNAPS = $NS
STARTING_SNAP = 0
NUM_BLOCKS = $RS_NUM_BLOCKS
NUM_WRITERS = $NW
FORK_READERS_FROM_WRITERS = 1
FORK_PROCESSORS_PER_MACHINE = $NW
PARALLEL_IO = 1
PARALLEL_IO_SERVER_ADDRESS = "localhost"
OUTBASE = "$HALO_DIR"
PERIODIC = 1
FORCE_RES = $FORCE_RES
PKC_SUBSAMPLES = "$RS_PKC_SUBSAMPLES"
TEMPORAL_HALO_FINDING = 1
STRICT_SO_MASSES = 0
MIN_HALO_OUTPUT_SIZE = $MIN_HALO_OUTPUT_SIZE
MIN_HALO_PARTICLES = $MIN_HALO_PARTICLES
UNBOUND_THRESHOLD = $UNBOUND_THRESHOLD
OVERLAP_LENGTH = 3
EOF
fi
# the configuration this job runs: writers and output directory set here (the rest as written in advance)
RUNCFG=$HALO_DIR/rs_job.cfg
sed -e '/^ *NUM_WRITERS *=/d' -e '/^ *FORK_PROCESSORS_PER_MACHINE *=/d' -e '/^ *OUTBASE *=/d' "$CFG" > "$RUNCFG"
printf 'NUM_WRITERS = %s\nFORK_PROCESSORS_PER_MACHINE = %s\nOUTBASE = "%s"\n' "$NW" "$PER_NODE" "$OUT" >> "$RUNCFG"
if [ "$NNODE" -gt 1 ]; then   # the clients on the other nodes must reach the server: this node's name, not localhost
  sed -i '/^ *PARALLEL_IO_SERVER_ADDRESS *=/d' "$RUNCFG"
  printf 'PARALLEL_IO_SERVER_ADDRESS = "%s"\n' "${NODES[0]}" >> "$RUNCFG"
fi
if [ -n "$NAMES" ]; then   # batch: cut snapshot list, restart at FIRST
  sed -i -e '/^ *SNAPSHOT_NAMES *=/d' -e '/^ *NUM_SNAPS *=/d' -e '/^ *STARTING_SNAP *=/d' -e '/^ *RESTART_SNAP *=/d' "$RUNCFG"
  printf 'SNAPSHOT_NAMES = "%s"\nSTARTING_SNAP = 0\n' "$NAMES" >> "$RUNCFG"
  [ "$FIRST" -gt 0 ] && printf 'RESTART_SNAP = %s\n' "$FIRST" >> "$RUNCFG"
  [ "$FIRST" -gt 0 ] && [ "$OUT" != "$HALO_DIR" ] && cp -p "$HALO_DIR"/halos_"$(sname $((FIRST - 1)))".*.bin "$OUT"/
fi
NB=$(awk -F= '$1 ~ /^ *NUM_BLOCKS *$/ {print $2+0}' "$RUNCFG")
stamp "Rockstar: snapshots $FIRST-$LAST of $NS, ${NB:-?} readers, $NW writers, FORCE_RES $FORCE_RES, config $RUNCFG"

copy_bins() {  # halos_<name>.*.bin from the local disk to $HALO_DIR, then delete the older sets there; each file is
  # copied to .<file>.part and renamed, so a job killed during the copy leaves no truncated file under the real name
  local f_ b_ ok_=1
  for f_ in "$OUT"/halos_"$1".*.bin; do
    b_=$(basename "$f_")
    [ "$(stat -c '%s %Y' "$f_")" = "$(stat -c '%s %Y' "$HALO_DIR/$b_" 2>/dev/null)" ] && continue   # copied before
    cp -p "$f_" "$HALO_DIR/.$b_.part" && mv -f "$HALO_DIR/.$b_.part" "$HALO_DIR/$b_" || { ok_=0; break; }
  done
  [ $ok_ = 1 ] && ls "$HALO_DIR" | grep '^halos_.*\.bin$' | grep -v "^halos_$1\." | sed "s|^|$HALO_DIR/|" | xargs -r rm -f
  [ $ok_ = 1 ]
}

sync_out() {  # finished catalogs and what a restart needs, from the local disk to $HALO_DIR
  [ "$OUT" = "$HALO_DIR" ] && return 0
  cp -p "$OUT"/out_*.list "$HALO_DIR"/ 2>/dev/null
  # rockstar.cfg: OUTBASE pointed back to $HALO_DIR (consistent-trees' gen_merger_cfg.pl finds out_*.list through it)
  [ -f "$OUT/rockstar.cfg" ] && sed "s|^ *OUTBASE *=.*|OUTBASE = \"$HALO_DIR\"|" "$OUT/rockstar.cfg" > "$HALO_DIR/rockstar.cfg"
  if [ -f "$OUT/restart.cfg" ]; then
    local r=$(awk -F= '$1 ~ /^ *RESTART_SNAP *$/ {print $2+0}' "$OUT/restart.cfg") last
    last=$(binsnaps "$OUT" | awk -v r="$r" '$1 != "" && $1 < r {n=$2} END {print n}')   # name of the newest finished
    if [ -n "$last" ]; then  # keep only the newest complete snapshot's binaries on /storage
      copy_bins "$last"
    fi
    sed "s|^ *OUTBASE *=.*|OUTBASE = \"$HALO_DIR\"|" "$OUT/restart.cfg" > "$HALO_DIR/restart.cfg"
  fi
}

t0=$(date +%s)
cd "$OUT"
rm -f auto-rockstar.cfg
SLOG=server.log; CLOG=client.log; [ -n "$NAMES" ] && SLOG=server.b$FIRST.log && CLOG=client.b$FIRST.log
"$RS" -c "$RUNCFG" > "$HALO_DIR/$SLOG" 2>&1 &
SPID=$!
for _ in $(seq 1 600); do [ -f auto-rockstar.cfg ] && break; sleep 0.5; done
[ -f auto-rockstar.cfg ] || { stamp "server did not write auto-rockstar.cfg"; tail "$HALO_DIR/$SLOG"; kill $SPID; exit 1; }
cp -p auto-rockstar.cfg "$HALO_DIR"/
( while kill -0 $SPID 2>/dev/null; do sleep "${RS_SYNC_S:-600}"; sync_out; done ) &
SYNCPID=$!
RPIDS=()
for nd in "${NODES[@]:1}"; do   # clients on the other nodes (same paths: shared file systems)
  ssh -o StrictHostKeyChecking=no -o BatchMode=yes "$nd" "cd '$OUT' && /usr/bin/time -v '$RS' -c auto-rockstar.cfg" \
      > "$HALO_DIR/${CLOG%.log}.$nd.log" 2> "$HALO_DIR/client.$nd.time" < /dev/null &
  RPIDS+=($!)
done
/usr/bin/time -v "$RS" -c auto-rockstar.cfg > "$HALO_DIR/$CLOG" 2> "$HALO_DIR/client.time"
wait $SPID; rc=$?
for p_ in "${RPIDS[@]}"; do wait "$p_" || { stamp "a remote client ended with an error (client.<node>.time)"; rc=1; }; done
for nd in "${NODES[@]:1}"; do echo "client on $nd: $(grep -E "Elapsed|Maximum resident" "$HALO_DIR/client.$nd.time" | sed 's/^[[:space:]]*//' | tr '\n' ';')"; done
kill $SYNCPID 2>/dev/null; wait $SYNCPID 2>/dev/null
ts=$(date +%s); sync_out
# after a successful run the last snapshot is complete too (restart.cfg still names it): keep its binaries,
# the next batch's merger links need them
LASTN=$(sname "$LAST")
if [ $rc -eq 0 ] && [ "$OUT" != "$HALO_DIR" ] && ls "$OUT"/halos_"$LASTN".*.bin > /dev/null 2>&1; then
  copy_bins "$LASTN"
fi
[ "$OUT" != "$HALO_DIR" ] && stamp "copied $(ls "$OUT"/out_*.list 2>/dev/null | wc -l) out_<snap>.list from $OUT in $(( $(date +%s) - ts )) s"
cd "$HALO_DIR"
grep -E "Elapsed|Maximum resident" client.time
n=0; for s_ in $(seq "$FIRST0" "$LAST"); do [ -f out_$s_.list ] && n=$((n+1)); done
NB_=$((LAST - FIRST0 + 1)); NRUN=$((LAST - FIRST + 1))
nsucc=$(grep -c '\[Success\] Done with snapshot' "$SLOG")
if [ "$OUT" != "$HALO_DIR" ] && [ $n -eq $NB_ ] && [ $rc -eq 0 ]; then
  for s_ in $(seq "$FIRST" "$LAST"); do
    cmp -s "$OUT/out_$s_.list" "$HALO_DIR/out_$s_.list" || { stamp "copy of out_$s_.list differs"; exit 1; }
  done
  ls "$HALO_DIR"/halos_"$LASTN".*.bin > /dev/null 2>&1 || { stamp "halos_$LASTN.*.bin (snapshot $LAST) not copied to $HALO_DIR"; exit 1; }
  rm -rf "$OUT"
fi
nh=$(grep -vc '^#' out_$LAST.list 2>/dev/null)
stamp "Rockstar exit $rc in $(( $(date +%s) - t0 )) s; $n of $NB_ out_<snap>.list ($FIRST0-$LAST), $nsucc snapshots [Success] in $SLOG; halos in the last: $nh"
ok=0; [ $rc -eq 0 ] && [ $n -eq $NB_ ] && { [ "$nsucc" -eq $NRUN ] || [ "${RESTARTED:-0}" = 1 ]; } && ok=1
event rockstar_done first="$FIRST0" last="$LAST" nsnap="$NS" nlists="$n" nsuccess="$nsucc" halos_last="${nh:-0}" ok="$ok" seconds="$(( $(date +%s) - t0 ))"
[ $ok = 1 ] || { tail -20 "$SLOG"; exit 1; }
