# Sahyadri variation var_Om_p: Omega_m raised, everything else as default.cosmo.
# From the pegasus CLASS input class_var_Om_p2048.ini (/mnt/home/student/csaee/chpc2501005/sahyadri-sandbox/
# config/transfer/sahyadri/, k_pivot = 0.05/Mpc, z_pk = 49); the pegasus 2048^3 run sims/sahyadri/var_Om_p2048 used it.
# Flat: dark energy density 1 - Omega_m - Omega_k.
OMEGA_M=0.3294607
OMEGA_B=0.0493017
OMEGA_K=0.0
HUBBLE=0.6736
NS=0.9649
AS=2.098903e-09
Z_START=49.0
# CLASS matter power spectrum at z = Z_START (k [h/Mpc], P [(Mpc/h)^3]): class_var_Om_p2048_pk.dat from pegasus,
# the table behind the NGenIC input class_var_Om_p2048_pk.txt. Path relative to this file.
PK_FILE=var_Om_p_class_pk_z49.dat
COMMENT="Sahyadri var_Om_p: OMEGA_M=0.3294607 (else default; CLASS P(k) at z=49)"
