# Sahyadri variation var_w_p: (w0, wa) raised, everything else as default.cosmo.
# From the pegasus CLASS input class_var_w_p2048.ini (/mnt/home/student/csaee/chpc2501005/sahyadri-sandbox/
# config/transfer/sahyadri/, k_pivot = 0.05/Mpc, z_pk = 49); the pegasus 2048^3 run sims/sahyadri/var_w_p2048 used it.
# Flat: dark energy density 1 - Omega_m - Omega_k.
OMEGA_M=0.3137721
OMEGA_B=0.0493017
OMEGA_K=0.0
HUBBLE=0.6736
NS=0.9649
AS=2.098903e-09
# CPL dark energy w(a) = W0 + WA (1 - a) (CLASS w0_fld, wa_fld with Omega_Lambda = 0; pkdgrav3 w0, wa, dOmegaDE)
W0=-0.96721742
WA=-0.12063991
Z_START=49.0
# CLASS matter power spectrum at z = Z_START (k [h/Mpc], P [(Mpc/h)^3]): class_var_w_p2048_pk.dat from pegasus,
# the table behind the NGenIC input class_var_w_p2048_pk.txt. Path relative to this file.
PK_FILE=var_w_p_class_pk_z49.dat
COMMENT="Sahyadri var_w_p: W0=-0.96721742 WA=-0.12063991 (else default; CLASS P(k) at z=49)"
