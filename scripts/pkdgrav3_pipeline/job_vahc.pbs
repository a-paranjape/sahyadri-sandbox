#!/bin/bash -l
# Stage 4: value-added catalogs out_<snap>.vahc (and .tens with PP_TENS=1) from the .pkc particles and the
# consistent-trees catalogs out_<snap>.trees (post-process/run_addvalue.py; production settings).
# Restart: rerun; snapshots whose outputs exist are skipped.
set -u
source "${PIPE_ENV:?pass -v CONF=...,PIPE_ENV=<repo>/scripts/pkdgrav3_pipeline/pipeline_env.sh}"
ls "$HALO_DIR"/out_*.trees > /dev/null 2>&1 || { stamp "no out_<snap>.trees in $HALO_DIR (run stage ctrees first)"; exit 1; }
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
TENS=; [ "$PP_TENS" = 1 ] && TENS=--tens
# PP_FAST=1 (default): vahc_fast.py (same results, one pass, multithreaded FFTs); PP_FAST=0: the original AddValue path
# PP_POT=1: also .vpot where the .pkc store the potential (needs PP_FAST=1)
[ "${PP_FAST:-1}" = 1 ] && TENS="$TENS --fast"
[ "${PP_POT:-0}" = 1 ] && TENS="$TENS --pot"
# PP_PK=1 (default): matter and halo-mass-bin P(k) of every output from the same grid (pk_measure.py), and CLASS
# P(k) at every output redshift (class_pk.py, once) for the checks in stage verify
if [ "${PP_PK:-1}" = 1 ]; then
  "$PY" "$PIPE/class_pk.py" "$CONF" || { stamp "class_pk.py failed"; exit 1; }
  TENS="$TENS --pk"; [ -n "${PK_MBINS:-}" ] && TENS="$TENS --pk-mbins $PK_MBINS"
fi
# PP_OVERWRITE=1: recompute every snapshot; the existing .vahc/.tens/.vpot are first copied to $HALO_DIR/vahc_prev/
# (only if that directory does not exist yet, so a restarted job never replaces the copies with its own outputs)
if [ "${PP_OVERWRITE:-0}" = 1 ]; then
  if [ ! -d "$HALO_DIR/vahc_prev" ]; then
    mkdir "$HALO_DIR/vahc_prev" && cp -p "$HALO_DIR"/out_*.vahc "$HALO_DIR"/out_*.tens "$HALO_DIR"/out_*.vpot "$HALO_DIR/vahc_prev/" 2>/dev/null
  fi
  stamp "PP_OVERWRITE=1: previous outputs in $HALO_DIR/vahc_prev ($(ls "$HALO_DIR/vahc_prev" | wc -l) files)"
  TENS="$TENS --overwrite"
fi
/usr/bin/time -v "$PY" "$PP/run_addvalue.py" "$STEM" --real "$REAL" --grid "$PP_GRID" --down-to "$PP_DOWN_TO" \
    $TENS --nproc "$PP_NPROC" 2> "$LOGS/vahc_time.${PBS_JOBID%%.*}.log" | grep -v '^\.\.\.'
rc=${PIPESTATUS[0]}
grep -E "Elapsed|Maximum resident" "$LOGS/vahc_time.${PBS_JOBID%%.*}.log"
stamp "run_addvalue exit $rc; $(ls "$HALO_DIR"/out_*.vahc 2>/dev/null | wc -l) .vahc, $(ls "$HALO_DIR"/out_*.tens 2>/dev/null | wc -l) .tens"
event vahc_done rc="$rc" npk="$(ls "$HALO_DIR"/out_*.pk 2>/dev/null | wc -l)" nvahc="$(ls "$HALO_DIR"/out_*.vahc 2>/dev/null | wc -l)" ntens="$(ls "$HALO_DIR"/out_*.tens 2>/dev/null | wc -l)" nvpot="$(ls "$HALO_DIR"/out_*.vpot 2>/dev/null | wc -l)"
exit $rc
